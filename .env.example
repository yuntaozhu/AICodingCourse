# Cloud SQL PostgreSQL connection (AI Studio primary; object params only)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Vercel / Neon Postgres fallback (object params; automatically enables TLS for remote hosts)
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Vercel Blob attachment storage (optional, used by /api/submissions/upload)
AICODING_STORE_ID=
AICODING_READ_WRITE_TOKEN=

# Optional Firebase Project ID override (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=

# Server-side Gemini API key (configured via platform Secrets in production; optional)
GEMINI_API_KEY=
PORT=3000

# Optional comma-separated initial admin emails & HMAC payment webhook secret
ADMIN_EMAIL=
PAYMENT_WEBHOOK_SECRET=
